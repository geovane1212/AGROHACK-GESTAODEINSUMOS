# Copie para .env e preencha. NUNCA versione o .env.

# Chave de sessão do Flask (gere uma com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Caminho do banco SQLite (padrão: instance/agrohack.db)
DATABASE_URL=sqlite:///instance/agrohack.db

# Data de referência das análises (AAAA-MM-DD). Vazio = data da última movimentação da base.
DATA_REFERENCIA=

# 1 = recria a base de demonstração (dados simulados) ao iniciar se o banco estiver vazio
SEED_DEMO=1
